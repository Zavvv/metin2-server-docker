# The official English names of this world's items and monsters, rendered by
# tools/generate_english_names.py from Gameforge's own tables: what the core
# names an item, a monster or an NPC by for a person whose client reads English
# - a bot's chat line, its shout, its shop's title, an NPC over its head
# (playerbot_language.h). Read once from here by every core; without it every
# name is the proto's Polish one.
COPY share-add/playerbot_names_en.tsv /opt/metin2/share/playerbot_names_en.tsv
COPY share-add/playerbot_live_chat_*.tsv /opt/metin2/share/

# The official English of the engine's own lines (LC_TEXT), rendered by
# tools/generate_engine_english.py from Gameforge's own tables: what a game core
# says itself - "You cannot...", a trade, a party, the anvil - to a person whose
# client reads English. Beside the Polish table it is keyed to, where every
# core reads it right after that table (playerbotify.py,
# apply_engine_english_table); without it every engine line is the table's
# Polish.
COPY share-add/locale_string_en.tsv /opt/metin2/share/locale/poland/locale_string_en.tsv

# The OX quiz's questions (Malina, 29 September: "pytania sa chyba po
# niemiecku"): Polish, each with its English twin - add_ox_quiz's fourth
# argument, which playerbotify's apply_ox_event reads - over the package's
# locale/poland/oxquiz.lua, which is the German server's file. The engine
# loads it at every opening of the quiz (oxevent.open).
COPY share-add/oxquiz.lua /opt/metin2/share/locale/poland/oxquiz.lua

# The cores run unprivileged and read this tree by path; a directory only root
# can enter costs every quest below it, silently. Repair, then assert.
RUN set -eu; \
    find /opt/metin2/share -type d ! -perm -005 -exec chmod a+rx {} + ; \
    find /opt/metin2/share -type f ! -perm -004 -exec chmod a+r  {} + ; \
    bad="$(find /opt/metin2/share \( -type d ! -perm -005 \) -o \( -type f ! -perm -004 \) | head -5)"; \
    if [ -n "$bad" ]; then \
      echo "FATAL: still not readable by the server account:"; echo "$bad"; exit 1; \
    fi; \
    echo "share tree is readable by the server account"

# The three quests compiled in the quests stage, as a pure addition on top of
# the package's own object tree (new files under quest/object/, the sources
# beside the stock ones). Empty when web_admin.quest was left out.
COPY --from=quests /out-quest/ /opt/metin2/share/locale/

# Seed for a core's mark/ directory (guild symbols): copied into the state
# volume on first run only.
COPY mark-default /opt/metin2/share/mark-default

COPY scripts/ /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh /usr/local/bin/m2-* /usr/local/bin/m2ctl \
 && chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/m2-* /usr/local/bin/m2ctl \
 && chmod 0755 /opt/metin2/share/bin/game /opt/metin2/share/bin/db

# ---- mutable half: everything the cores write lives here, and only here.
RUN mkdir -p /opt/metin2/var && chown metin2:metin2 /opt/metin2/var
VOLUME ["/opt/metin2/var"]

ENV M2_SHARE_DIR=/opt/metin2/share \
    M2_VAR_DIR=/opt/metin2/var \
    TZ=UTC

EXPOSE 11000/tcp 13000/tcp 13001/tcp 13002/tcp

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=4 \
    CMD ["/usr/local/bin/m2-healthcheck"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["m2-supervise"]
