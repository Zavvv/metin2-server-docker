-- The Dom Towarowy (Uxie [DSO]'s flea market, taken 27 September): the
-- miscellaneous merchant of a first village offers every offline shop's
-- listing, players' and bots', in one window (customfleamarket.py in the
-- client root; the catalogue and the purchase are ikarus_shop_manager.cpp's,
-- playerbotify apply_flea_market) beside her own shop.
--
-- Only while the world has it on - M2_FLEA_MARKET in .env, the launcher's
-- difficulty window, which the migrator turns into m2_flea_market_off - and
-- only in M1. Anywhere else, or off, neither option is offered, and a click
-- on her opens her shop as it always did. The server asks the same two
-- questions again at every /flea_ command.
--
-- subquest_10 already offers a shop while the player hunts for shoes. Reuse
-- that option in its active state instead of adding the same shop twice.
-- Resolve its state from qc's table: never hard-code the state's CRC.
-- Our two options are Polish or English as the player's client asked
-- (playerbot_lang.quest): the engine reads an option's words when she is
-- clicked (NPC::OnChat, ScriptToString), with the clicking player's flag.
quest flea_market begin
	state start begin
		function t(pl, en)
			if pc.getf("playerbot_lang", "en") == 1 then
				return en
			end
			return pl
		end

		function needs_shop_option()
			local stock = subquest_10
			return stock == nil or stock.hunt_for_shoes == nil or
					pc.getf("subquest_10", "__status") ~= stock.hunt_for_shoes
		end

		when 9003.chat.flea_market.t("Kup przedmioty", "Buy items") with game.get_event_flag("m2_flea_market_off") == 0 and
				(pc.get_map_index() == 1 or pc.get_map_index() == 21 or pc.get_map_index() == 41) and flea_market.needs_shop_option() begin
			setskin(NOWINDOW)
			npc.open_shop()
		end

		when 9003.chat.flea_market.t("Dom Towarowy", "Flea Market") with game.get_event_flag("m2_flea_market_off") == 0 and
				(pc.get_map_index() == 1 or pc.get_map_index() == 21 or pc.get_map_index() == 41) begin
			setskin(NOWINDOW)
			cmdchat("FleaMarketOpen")
		end
	end
end
