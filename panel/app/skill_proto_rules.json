{
  "format": 1,
  "table": "world.skill_proto",
  "source": "Iwakura x Tyrion Patch 19, point 12. The mt2009 engine's own reader: db/src/ClientManagerBoot.cpp InitializeSkillTable, game/src/skill.cpp CSkillManager::Initialize with PlayerBotCheckSkillRow (playerbotify apply_skill_proto_validation), common/length.h SKILL_MAX_NUM 265 and SKILL_MAX_LEVEL 40.",
  "restart": "The db core reads world.skill_proto once, at its boot, and hands it to every game core: a change takes effect after the server's restart.",
  "on_error": "A value the core cannot use is written to syserr as a PLAYERBOT_SKILL_PROTO line and replaced by the value given as 'fallback' below; a row whose dwVnum is outside 1..264 is skipped. The server starts either way.",
  "point_types": ["NONE", "MAX_HP", "MAX_SP", "HP_REGEN", "SP_REGEN", "BLOCK", "HP", "SP", "ATT_GRADE", "DEF_GRADE", "MAGIC_ATT_GRADE", "MAGIC_DEF_GRADE", "BOW_DISTANCE", "MOV_SPEED", "ATT_SPEED", "POISON_PCT", "RESIST_RANGE", "CASTING_SPEED", "REFLECT_MELEE", "ATT_BONUS", "DEF_BONUS", "RESIST_NORMAL", "DODGE", "KILL_HP_RECOVER", "KILL_SP_RECOVER", "HIT_HP_RECOVER", "HIT_SP_RECOVER", "CRITICAL", "MANASHIELD", "SKILL_DAMAGE_BONUS", "NORMAL_HIT_DAMAGE_BONUS", "BLEEDING_PCT", "TERROR", "ATT_GRADE_MOB", "MAGIC_ATT", "MAGIC_ATT_MOB", "MAGIC_ATT_GRADE_MOB", "RESIST_MOB_1000PCT", "ABSORB_DAMAGE_MOB", "RESIST_PENETRATE", "ATT_SPECIAL"],
  "affect_flags": ["NONE", "YMIR", "INVISIBILITY", "SPAWN", "POISON", "SLOW", "STUN", "DUNGEON_READY", "FORCE_VISIBLE", "BUILDING_CONSTRUCTION_SMALL", "BUILDING_CONSTRUCTION_LARGE", "BUILDING_UPGRADE", "MOV_SPEED_POTION", "ATT_SPEED_POTION", "FISH_MIDE", "JEONGWIHON", "GEOMGYEONG", "CHEONGEUN", "GYEONGGONG", "EUNHYUNG", "GWIGUM", "TERROR", "JUMAGAP", "HOSIN", "BOHO", "KWAESOK", "MANASHIELD", "MUYEONG", "REVIVE_INVISIBLE", "FIRE", "GICHEON", "JEUNGRYEOK", "CHARGE_DASH", "DISPEL", "STRONG_BODY_WITH_FALL", "POLYMORPH", "WARFLAG1", "WARFLAG2", "WARFLAG3", "CHINA_FIREWORK", "HAIR", "SPRINT", "SPRINT_HORSE", "BLOODTHIRST", "HEAVEN_PROTECTION", "FIRE_RAGE", "DEMONIC_SPIRIT"],
  "skill_flags": ["ATTACK", "USE_MELEE_DAMAGE", "COMPUTE_ATTGRADE", "SELFONLY", "USE_MAGIC_DAMAGE", "USE_HP_AS_COST", "COMPUTE_MAGIC_DAMAGE", "SPLASH", "GIVE_PENALTY", "USE_ARROW_DAMAGE", "PENETRATE", "IGNORE_TARGET_RATING", "ATTACK_SLOW", "ATTACK_STUN", "HP_ABSORB", "SP_ABSORB", "ATTACK_FIRE_CONT", "REMOVE_BAD_AFFECT", "REMOVE_GOOD_AFFECT", "CRUSH", "ATTACK_POISON", "TOGGLE", "DISABLE_BY_POINT_UP", "CRUSH_LONG", "CRUSH_MOB_ONLY", "STUN_MOB_ONLY", "THIRD_POINT_SELFONLY"],
  "formula": "A formula is read by the engine's CPoly: numbers, + - * / ^, parentheses and the variables the skill code binds (k = the skill's power by level, lv, iq, str, dex, con, atk, def, ar, wep, ...). Up to 100 characters. One the engine cannot parse becomes 0.",
  "fields": {
    "dwVnum": {"type": "int", "min": 1, "max": 264, "locked": true, "restart": true,
      "why": "The skill's number indexes every character's skill array and the client's skill tables; changing it orphans what characters learned. A row outside 1..264 is skipped."},
    "szName": {"type": "string", "max_length": 32, "locked": false, "restart": true,
      "why": "The engine's own name of the skill (logs, GM commands). The client shows its own skilldesc."},
    "bType": {"type": "int", "allowed": [0, 1, 2, 3, 4, 5, 6, 7], "locked": true, "restart": true,
      "why": "Whose skill it is: 0 common, 1 warrior, 2 ninja, 3 sura, 4 shaman, 5 horse, 6 the passive resistances against a job, 7 wolfman. Another value is logged and kept; a skill moved to another job is learnable by the wrong job."},
    "bLevelStep": {"type": "int", "min": 0, "max": 10, "locked": false, "restart": true},
    "bMaxLevel": {"type": "int", "min": 0, "max": 40, "fallback": 40, "locked": false, "restart": true,
      "why": "Over 40 reads the power tables past their end; it is cut to 40."},
    "bLevelLimit": {"type": "int", "min": 0, "max": 120, "locked": false, "restart": true},
    "szPointOn": {"type": "enum", "values_from": "point_types", "fallback": "NONE", "locked": false, "restart": true},
    "szPointOn2": {"type": "enum", "values_from": "point_types", "fallback": "NONE", "locked": false, "restart": true},
    "szPointOn3": {"type": "enum", "values_from": "point_types", "empty_allowed": true, "fallback": "NONE", "locked": false, "restart": true},
    "szPointPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szSPCostPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szDurationPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szDurationSPCostPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szCooldownPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szMasterBonusPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szAttackGradePoly": {"type": "formula", "max_length": 100, "locked": true, "restart": true,
      "why": "Not read by this engine (the db core does not select it): an edit does nothing."},
    "szPointPoly2": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szDurationPoly2": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szPointPoly3": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szDurationPoly3": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szGrandMasterAddSPCostPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "szSplashAroundDamageAdjustPoly": {"type": "formula", "max_length": 100, "fallback": "0", "locked": false, "restart": true},
    "setFlag": {"type": "set", "values_from": "skill_flags", "locked": false, "restart": true,
      "why": "How the skill is cast and hits. A wrong flag does not stop the server, but can make a buff an attack or the reverse."},
    "setAffectFlag": {"type": "enum", "values_from": "affect_flags", "fallback": "NONE", "locked": false, "restart": true},
    "setAffectFlag2": {"type": "enum", "values_from": "affect_flags", "fallback": "NONE", "locked": false, "restart": true},
    "setAffectFlag3": {"type": "enum", "values_from": "affect_flags", "fallback": "NONE", "locked": false, "restart": true},
    "prerequisiteSkillVnum": {"type": "int", "min": 0, "max": 264, "fallback": 0, "locked": false, "restart": true,
      "why": "Over 264 indexed the skill arrays out of bounds; it becomes 0 (no prerequisite)."},
    "prerequisiteSkillLevel": {"type": "int", "min": 0, "max": 40, "fallback": 40, "locked": false, "restart": true},
    "eSkillType": {"type": "enum", "values": ["NORMAL", "MELEE", "RANGE", "MAGIC"], "locked": false, "restart": true},
    "iMaxHit": {"type": "int", "min": 0, "max": 127, "fallback": 0, "locked": false, "restart": true},
    "dwTargetRange": {"type": "int", "min": 0, "max": 50000, "fallback": 0, "locked": false, "restart": true},
    "dwSplashRange": {"type": "int", "min": 0, "max": 50000, "fallback": 0, "locked": false, "restart": true}
  }
}
