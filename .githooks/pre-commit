git add game/Dockerfile game/quest/clam_opening.quest
powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-dragon-soul-refine.ps1 -Mode Verify
powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-clam-opening.ps1 -Mode Verify
