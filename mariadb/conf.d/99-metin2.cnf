# =============================================================================
#  MariaDB settings the mt2009 server files require.
# =============================================================================
[mysqld]

# The schema carries '0000-00-00 00:00:00' defaults and the cores write values
# strict mode rejects; the db core is built with live assert()s and aborts on
# a refused write rather than warning.
sql_mode = NO_ENGINE_SUBSTITUTION

# The game connects with SET NAMES cp1250 (locale poland) and every dumped
# table names its own charset; this is only the default for what gets created
# afterwards.
character-set-server = cp1250
collation-server     = cp1250_general_ci

max_connections = 200

# The twelve log tables are MyISAM and do not survive an unclean stop; FORCE
# runs the full repair. No BACKUP: it keeps a whole copy of the damaged data
# file (log-<time>.BAK) beside the table at every automatic repair, and nothing
# ever removes one - on a VPS a log.log of six gigabytes crashed, was repaired
# and copied again and again until the disk was full (ziolek, 16 October).
# The twelve are history only (every table of account, common, player and
# world is InnoDB on this line), and the migrator empties one whose repair the
# disk cannot hold instead of trying it.
myisam_recover_options = FORCE

# log.log's history is trimmed by an event the migrator writes
# (log.playerbot_log_retention, M2_DB_LOG_KEEP_DAYS); the migrator switches
# the scheduler on as well, this keeps it on across a restart of the database.
event_scheduler = ON

# Durability per statement is what a bank needs, and what hung the login on a
# world of 2482 bots: the game's tables are InnoDB here, and with the default
# flush-on-every-commit each of their ~100 writes a second waited for an fsync
# on Docker Desktop's disk (~70 a second on the test machine). The db core's
# player queue held ~1900 queries, and a player's login - one SELECT at the
# back of that queue - was answered 14-28 seconds later, after the client had
# given up ("wisi na ekranie logowania", the contributor, 2.0.11). Flushing the log
# once a second instead loses at most a second of saves if the machine loses
# power, and lets the queue drain as fast as the disk can write.
innodb_flush_log_at_trx_commit = 2

# The redo log's 96 MB default is checkpointed every few seconds under the
# game's writes, and every checkpoint writes the pages it covers out again:
# with the buffer pool grown to a gigabyte or two (the entrypoint in the
# compose file sizes it) a 96 MB log would flush most of it over and over -
# a VPS of 16 GB wrote 179 GB a day (report 5acdc810, issue #130). 512 MB lets
# a page change many times between two writes of it, at 416 MB more on the
# disk. MariaDB 11.8 resizes the log of an existing world at its next start.
innodb_log_file_size = 512M
